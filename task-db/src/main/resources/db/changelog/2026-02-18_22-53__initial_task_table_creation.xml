<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet author="inkognito" id="2026-02-18_22-53__initial_task_table_creation.xml_1">
        <createTable tableName="task">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="text">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false" checkConstraint="status IN ('CREATED', 'DONE', 'ERROR')"/>
            </column>
            <column name="assignee" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="notificate_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_task_assignee" tableName="task">
            <column name="assignee"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>