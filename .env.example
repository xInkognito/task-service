# Database settings
DB_URL=jdbc:postgresql://localhost:54321/dbname
DB_USER=postgres
DB_PASSWORD=your_password
DB_SCHEMA=public

# Kafka
KAFKA_SERVERS=localhost:9092

# Security (Replace with real values in your local .env)
JWT_SECRET=your_super_secret_key_at_least_64_symbols_long_change_it_in_prod
TECH_TOKEN=your_internal_service_token

# Services
USER_SERVICE_URL=http://localhost:9000